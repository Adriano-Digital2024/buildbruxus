{
  "name": "buildbruxus-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BuildBruxus SaaS — chat em tempo real com Supabase + planos Stripe, deploy em Cloudflare Pages",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "stripe:listen": "stripe listen --forward-to http://localhost:8788/api/stripe-webhook"
  },
  "dependencies": {
    "@stripe/stripe-js": "^4.9.0",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "stripe": "^16.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}