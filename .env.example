# ============================================
# Variáveis públicas (expostas no navegador — precisam do prefixo VITE_)
# Configure estas no painel do Cloudflare Pages: Settings > Environment variables
# ============================================
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# URL base onde o SaaS roda (usada nas redirects do Stripe Checkout)
VITE_APP_URL=http://localhost:5173

# ============================================
# Variáveis SECRETAS (somente no Cloudflare Pages — NUNCA commitadas)
# Usadas pelas Cloudflare Pages Functions em functions/api/
# Marque como "Encrypt" no painel do CF.
# ============================================
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Para rodar webhook localmente: stripe listen --forward-to http://localhost:8788/api/stripe-webhook